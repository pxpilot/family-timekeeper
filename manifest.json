{
  "manifest_version": 3,
  "name": "Family Timekeeper",
  "short_name": "Timekeeper",
  "version": "1.0.0",
  "description": "Daily time budgets, allowed hours and session breaks for YouTube, TikTok and Instagram \u2014 including embeds on other sites.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "idle",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Family Timekeeper"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "src/content/tracker.js"
      ],
      "css": [
        "src/content/tracker.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "src/content/embeds.js"
      ],
      "css": [
        "src/content/embeds.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}